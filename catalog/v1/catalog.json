    {
      "id": "bigquery-firestore-export",
      "name": "Export BigQuery to Firestore",
      "summary": "Copy the rows of BigQuery queries into Firestore on a schedule. Google reserved the package for the official kit, which is not published yet.",
      "publisher": "firebase",
      "package": "@firebase-function-kits/bigquery-firestore-export",
      "version": "0.0.1",
      "status": "announced",
      "integrity": "sha512-jblQ9CgNbZ+LL85gFXEEE0rP/A9f0/qqQQ3r47A5ZCoerByImPfEXzb+7ioGjyKA6yPhFiff8xJiZZN8sCF4cw==",
      "license": "Apache-2.0",
      "repository": "https://github.com/firebase/extensions",
      "homepage": "https://github.com/firebase/extensions#readme",
      "npmUrl": "https://www.npmjs.com/package/@firebase-function-kits/bigquery-firestore-export/v/0.0.1",
      "categories": [
        "analytics"
      ],
      "icon": "IconDatabaseImport",
      "replaces": [
        "firebase/bigquery-firestore-export",
