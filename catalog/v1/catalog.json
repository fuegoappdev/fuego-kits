    {
      "id": "firestore-bigquery-export",
      "name": "Stream Firestore to BigQuery",
      "summary": "Mirror a Cloud Firestore collection to BigQuery in real time: a changelog table plus a view of the latest state of each document.",
      "publisher": "firebase",
      "package": "@firebase-function-kits/firestore-bigquery-export",
      "version": "0.1.1",
      "status": "available",
      "integrity": "sha512-mGV8vCMbC7L4iUB1xpidQ/FU5e67VtErAslyGET8JLO2HArgNL7ip0Sm3jaDPZ2RTrsLx/vI04X/d5vKbWyIzA==",
      "license": "Apache-2.0",
      "repository": "https://github.com/firebase/extensions/tree/HEAD/kits/firestore-bigquery-export",
      "npmUrl": "https://www.npmjs.com/package/@firebase-function-kits/firestore-bigquery-export/v/0.1.1",
      "readme": "readme/firestore-bigquery-export.md",
      "categories": [
        "analytics"
      ],
      "icon": "IconChartBar",
      "replaces": [
        "firebase/firestore-bigquery-export"
      ],
      "node": ">=22",
      "firebaseFunctions": "7.4.0",
      "functions": [
        {
          "name": "fsexportbigquery",
          "trigger": "firestore",
          "eventType": "google.cloud.firestore.document.v1.written",
          "resource": "{{ params.COLLECTION_PATH }}/{documentId}"
        },
        {
          "name": "initBigQuerySync",
          "trigger": "taskQueue"
        },
        {
          "name": "setupBigQuerySync",
          "trigger": "taskQueue"
        },
        {
          "name": "syncBigQuery",
          "trigger": "taskQueue"
        }
      ],
      "params": [
        {
          "name": "BIGQUERY_PROJECT_ID",
          "label": "BigQuery Project ID",
          "description": "Override the default project for BigQuery instance. This can allow updates to be directed to to a BigQuery instance on another GCP project.",
          "input": {
            "text": {
              "nonEmpty": true
            }
          },
          "type": "string",
          "default": "{{ params.PROJECT_ID }}"
        },
        {
          "name": "DATABASE",
          "label": "Firestore Instance ID",
          "description": "The Firestore database to use. Use \"(default)\" for the default database. You can view your available Firestore databases at https://console.cloud.google.com/firestore/databases.",
          "input": {
            "text": {
              "example": "(default)",
              "nonEmpty": true
            }
          },
          "type": "string",
          "default": "(default)"
